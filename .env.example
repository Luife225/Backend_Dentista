POSTGRES_DB=coronyx
POSTGRES_USER=coronyx_app
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_PORT=5432

DB_URL=jdbc:postgresql://localhost:5432/coronyx
DB_USERNAME=coronyx_app
DB_PASSWORD=replace_with_the_same_local_password
SERVER_PORT=8080

# CoroVoz Python: el backend inicia el servicio local automáticamente.
COROVOZ_PYTHON_URL=http://127.0.0.1:8787
COROVOZ_PYTHON_HOST=127.0.0.1
COROVOZ_PYTHON_PORT=8787
# COROVOZ_PYTHON_COMMAND=python
# COROVOZ_PYTHON_SCRIPT=C:\absolute\path\to\corovoz_python\server.py
# COROVOZ_PYTHON_AUTOSTART=false
# Para servicio remoto, configura el mismo secreto en ambos procesos y usa HTTPS.
# COROVOZ_SERVICE_TOKEN=replace_with_a_long_random_secret

# Luna es opcional y permanece apagado hasta configurar estas variables en el servidor.
# Usa una clave API de proyecto solo en el backend; no la incluyas en el frontend.
# COROVOZ_LUNA_ENABLED=true
# OPENAI_API_KEY=replace_with_your_project_api_key
# COROVOZ_LUNA_DAILY_LIMIT=50
# COROVOZ_LUNA_MONTHLY_USD=1.00
# COROVOZ_LUNA_GLOBAL_MONTHLY_USD=3.00
# COROVOZ_LUNA_USAGE_DB=C:\absolute\path\to\luna_usage.sqlite

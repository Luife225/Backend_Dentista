# Configuración de Jitsi Meet Docker para teleconsulta integrada y alojada localmente
# Compatible con Docker Desktop en Windows (WSL2 / Hyper-V)

HTTP_PORT=8080
HTTPS_PORT=8443
PUBLIC_URL=https://localhost:8443

# Autenticación obligatoria con JWT: sin invitados anónimos ni tokens vacíos
ENABLE_AUTH=1
AUTH_TYPE=jwt
ENABLE_GUESTS=0
JWT_APP_ID=coronyx-telemed
JWT_APP_SECRET=coronyx-dental-system-secret-key-2026-super-secure-token-jwt-utp-platform
JWT_ACCEPTED_ISSUERS=coronyx-telemed
JWT_ACCEPTED_AUDIENCES=jitsi

# Configuración de carpetas locales
CONFIG=./jitsi-config
RESTART_POLICY=unless-stopped
TZ=America/Lima
